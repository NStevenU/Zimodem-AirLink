; AIRLINK.INF
; Windows 95, 98, ME, NT 4.0, 2000, XP Modem Installation File
; Device: AirLink 56K Serial Modem
; Reference Architecture: U.S. Robotics 56K Faxmodem External (USR5686E)
; Firmware Target: Zimodem (ESP32-C3)
; Copyright (C) 2026 Nexisson Tech Co., Ltd.

[Version]
Signature   = "$CHICAGO$"
Class       = Modem
ClassGUID   = {4D36E96D-E325-11CE-BFC1-08002BE10318}
Provider    = %Mfg%
DriverVer   = 09/23/2026, 1.0.0.0

[Manufacturer]
%Mfg% = AirLink, NT.5.1

; Windows 95, 98, ME, NT 4.0, 2000
[AirLink]
%AirLink56K% = Modem_AirLink56K, UNIMODEM_AIRLINK

; Windows XP (NT 5.1) 32-bit
[AirLink.NT.5.1]
%AirLink56K% = Modem_AirLink56K, UNIMODEM_AIRLINK

; --- Installation Sections ---

[Modem_AirLink56K]
AddReg = All, Common, Modem_AirLink56K.AddReg, Settings_AirLink, External, Responses_AirLink

; --- Windows Core (VxD, DLL & Housing) ---

[All]
HKR,, FriendlyDriver,, "unimodem.vxd"
HKR,, DevLoader,,      *vcomm
HKR,, ConfigDialog,,   "modemui.dll"
HKR,, EnumPropPages,,  "modemui.dll,EnumPropPages"
HKR,, Contention,,     *vcd
HKR,, PortSubClass, 1, 02

[External]
HKR,, DeviceType, 1, 01

; --- Common Device Capabilities & Settings Tokens ---

[Common]
HKR,, Reset,, "ATZ<cr>"
HKR, Hangup, 1,, "ATH<cr>"
HKR, Answer, 1,, "ATA<cr>"
HKR, Monitor, 1,, "ATS0=0<cr>"
HKR, Monitor, 2,, "None"

; Standard Unimodem Dialing & Settings Tokens
HKR, Settings, Prefix,, "AT"
HKR, Settings, Terminator,, "<cr>"
HKR, Settings, DialPrefix,, "D"
HKR, Settings, DialSuffix,, ""
HKR, Settings, Tone,, "T"
HKR, Settings, Pulse,, "P"
HKR, Settings, Blind_Off,, "X1"
HKR, Settings, Blind_On,, "X0"
HKR, Settings, CallSetupFailTimer,, "S7=<#>"
HKR, Settings, InactivityTimeout,, "S30=<#>"

; Speaker Control (Zimodem sound engine: M0=off, M1=dial/handshake, M2=always)
HKR, Settings, SpeakerMode_Off,, "M0"
HKR, Settings, SpeakerMode_Dial,, "M1"
HKR, Settings, SpeakerMode_On,, "M2"
HKR, Settings, SpeakerMode_Setup,, "M1"
HKR, Settings, SpeakerVolume_Low,, ""
HKR, Settings, SpeakerVolume_Med,, ""
HKR, Settings, SpeakerVolume_High,, ""

; Modulation
HKR, Settings, Modulation_CCITT,, "B0"
HKR, Settings, Modulation_Bell,, "B1"

; Unsupported feature suppression (prevent sending ERROR-inducing AT commands)
HKR, Settings, ErrorControl_Off,, ""
HKR, Settings, ErrorControl_On,, ""
HKR, Settings, ErrorControl_Forced,, ""
HKR, Settings, Compression_Off,, ""
HKR, Settings, Compression_On,, ""

; --- Modem Capabilities & Settings ---

[Modem_AirLink56K.AddReg]
; Properties (24 bytes): Max DTE=115200 (00,C2,01,00), Max DCE=56000 (60,EA,00,00), SpeakerVolume=0
HKR,, Properties, 1, 80,01,00,00, FF,00,00,00, FF,00,00,00, 00,00,00,00, 07,00,00,00, F7,03,00,00, 00,C2,01,00, 60,EA,00,00
HKR,, InactivityScale, 1, 0a,00,00,00

[Settings_AirLink]
HKR, Init, 1,, "AT<cr>"
HKR, Init, 2,, "ATE0Q0V1&K3<cr>"
HKR, Settings, FlowControl_Hard,, "&K3"
HKR, Settings, FlowControl_Soft,, "&K4"
HKR, Settings, FlowControl_Off,, "&K0"

; --- Responses Table (ASCII & Numeric) ---

[Responses_AirLink]
; Standard Result Codes
HKR, Responses, "<cr><lf>OK<cr><lf>",         1, 00, 00, 00,00, 00,00, 00,00,00,00
HKR, Responses, "<cr><lf>RING<cr><lf>",       1, 08, 00, 00,00, 00,00, 00,00,00,00
HKR, Responses, "<cr><lf>NO CARRIER<cr><lf>", 1, 04, 00, 00,00, 00,00, 00,00,00,00
HKR, Responses, "<cr><lf>ERROR<cr><lf>",      1, 03, 00, 00,00, 00,00, 00,00,00,00
HKR, Responses, "<cr><lf>NO DIALTONE<cr><lf>",1, 05, 00, 00,00, 00,00, 00,00,00,00
HKR, Responses, "<cr><lf>BUSY<cr><lf>",       1, 06, 00, 00,00, 00,00, 00,00,00,00
HKR, Responses, "<cr><lf>NO ANSWER<cr><lf>",  1, 07, 00, 00,00, 00,00, 00,00,00,00
HKR, Responses, "<cr><lf>CONNECT<cr><lf>",    1, 02, 00, 00,00, 00,00, 00,00,00,00

; Extended Speed Responses (ASCII)
HKR, Responses, "CONNECT 115200", 1, 02, 00, 00,c2,01,00, 00,00,00,00
HKR, Responses, "CONNECT 57600",  1, 02, 00, 00,e1,00,00, 00,00,00,00
HKR, Responses, "CONNECT 56000",  1, 02, 00, 60,ea,00,00, 00,00,00,00
HKR, Responses, "CONNECT 38400",  1, 02, 00, 00,96,00,00, 00,00,00,00
HKR, Responses, "CONNECT 33600",  1, 02, 00, 40,83,00,00, 00,00,00,00
HKR, Responses, "CONNECT 28800",  1, 02, 00, 80,70,00,00, 00,00,00,00
HKR, Responses, "CONNECT 19200",  1, 02, 00, 00,4b,00,00, 00,00,00,00
HKR, Responses, "CONNECT 14400",  1, 02, 00, 40,38,00,00, 00,00,00,00
HKR, Responses, "CONNECT 9600",   1, 02, 00, 80,25,00,00, 00,00,00,00
HKR, Responses, "CONNECT 4800",   1, 02, 00, c0,12,00,00, 00,00,00,00
HKR, Responses, "CONNECT 2400",   1, 02, 00, 60,09,00,00, 00,00,00,00
HKR, Responses, "CONNECT 1200",   1, 02, 00, b0,04,00,00, 00,00,00,00
HKR, Responses, "CONNECT 300",    1, 02, 00, 2c,01,00,00, 00,00,00,00

; Numeric Responses (ATV0)
HKR, Responses, "0<cr>",  1, 00, 00, 00,00, 00,00, 00,00,00,00 ; OK
HKR, Responses, "1<cr>",  1, 02, 00, 00,00, 00,00, 00,00,00,00 ; CONNECT
HKR, Responses, "2<cr>",  1, 08, 00, 00,00, 00,00, 00,00,00,00 ; RING
HKR, Responses, "3<cr>",  1, 04, 00, 00,00, 00,00, 00,00,00,00 ; NO CARRIER
HKR, Responses, "4<cr>",  1, 03, 00, 00,00, 00,00, 00,00,00,00 ; ERROR
HKR, Responses, "5<cr>",  1, 02, 00, b0,04,00,00, 00,00,00,00 ; CONNECT 1200
HKR, Responses, "6<cr>",  1, 05, 00, 00,00, 00,00, 00,00,00,00 ; NO DIALTONE
HKR, Responses, "7<cr>",  1, 06, 00, 00,00, 00,00, 00,00,00,00 ; BUSY
HKR, Responses, "8<cr>",  1, 07, 00, 00,00, 00,00, 00,00,00,00 ; NO ANSWER
HKR, Responses, "10<cr>", 1, 02, 00, 60,09,00,00, 00,00,00,00 ; CONNECT 2400
HKR, Responses, "11<cr>", 1, 02, 00, c0,12,00,00, 00,00,00,00 ; CONNECT 4800
HKR, Responses, "12<cr>", 1, 02, 00, 80,25,00,00, 00,00,00,00 ; CONNECT 9600
HKR, Responses, "13<cr>", 1, 02, 00, 40,38,00,00, 00,00,00,00 ; CONNECT 14400
HKR, Responses, "24<cr>", 1, 02, 00, 20,1c,00,00, 00,00,00,00 ; CONNECT 7200
HKR, Responses, "25<cr>", 1, 02, 00, e0,2e,00,00, 00,00,00,00 ; CONNECT 12000
HKR, Responses, "28<cr>", 1, 02, 00, 00,c2,01,00, 00,00,00,00 ; CONNECT 115200

[Strings]
Mfg         = "Nexisson Tech Co., Ltd."
AirLink56K  = "AirLink 56K Serial Modem"
